    <string name="playback">Playback</string>

    <string name="play_in_background_setting_title">Play in background</string>
    <string name="play_in_background_setting_description">Tap for additional explanation</string>
    <string name="play_in_background_explanation">Enabling play in background will:</string>
    <string name="play_in_background_explanation_bullet_1">
        Allow playback to occur alongside playback from other apps</string>
    <string name="play_in_background_explanation_bullet_2">
        Make playback controls appear in a regular notification instead
        of in the media controls section of the status bar</string>
    <string name="play_in_background_explanation_bullet_3">
        Make playback ignore hardware media buttons (e.g. a headset’s
        play/pause button) unless the app is in the foreground</string>
    <string name="play_in_background_explanation_bullet_4">
        Prevent playback from auto-pausing during calls, unless the ‘Auto-pause during
        calls’ setting is enabled and the read phone state permission is granted
    </string>

    <string name="request_notification_permission_title">Notification permission required</string>
    <string name="request_notification_permission_explanation_p1">
        When play in background is turned on, Mistysound must use a regular
        notification to display the player controls (as opposed to a media session
        card). In order to do this, it must have permission to post notifications.
        This is optional, but without permission Mistysound will be unable to display
        a notification containing player controls when play in background is turned
        on.</string>
    <string name="request_notification_permission_explanation_p2">
        If you would rather not give permission, or if you would like to save
        the notification space, you can alternatively %1$s.</string>
    <string name="tile_tutorial_link_text">control Mistysound through its quick settings tile</string>

    <string name="auto_pause_during_calls_setting_title">Auto-pause during calls</string>
    <string name="auto_pause_during_calls_setting_subtitle">
        Requires read phone state permission\nOnly needed when playing in background</string>
    <string name="request_phone_state_permission_explanation">
        When not playing audio in the background, your device will let Mistysound
        know that it should pause playback during a call. This will not occur when
        audio is playing in the background. The read phone state permission is
        needed in this case so that Mistysound can detect when a call is ongoing
        and pause playback accordingly.</string>

    <string name="on_zero_volume_behavior_setting_title">
        Behavior on zero volume</string>
    <string name="on_zero_volume_behavior_setting_description">
        This setting will determine how playback will respond to an audio
        device change that results in a volume of zero (e.g. disconnecting
        a headset while the phone’s speakerphone volume is zero).</string>
    <string name="stop_playback_on_zero_volume_title">Stop playback</string>
    <string name="stop_playback_on_zero_volume_description">
        Automatically stop the app’s background service.</string>
    <string name="pause_playback_on_zero_volume_title">Pause playback</string>
    <string name="pause_playback_on_zero_volume_description">
        Playback will automatically resume if another audio device change results
        in a greater than zero media volume (e.g. you reconnect a headset). This
        setting may result in slightly higher battery usage due to the
        app remaining in a paused state in the background.</string>
    <string name="do_nothing_on_zero_volume_title">Do nothing</string>
    <string name="do_nothing_on_zero_volume_description">
        This setting will result in the highest battery usage because
        the app will remain playing even though it cannot be heard.
    </string>


